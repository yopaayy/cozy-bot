// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  discordId   String    @id @map("discord_id") @db.VarChar(32)
  username    String?   @db.VarChar(64)
  isVerified  Boolean   @default(false) @map("is_verified")
  isRegistered Boolean   @default(false) @map("is_registered")
  cozyCash    BigInt    @default(0) @map("cozy_cash")
  cozyBank    BigInt    @default(0) @map("cozy_bank")
  hideBank    Boolean   @default(false) @map("hide_bank")
  dailyStreak Int       @default(0) @map("daily_streak")
  lastDaily   DateTime? @map("last_daily")
  lastWeekly  DateTime? @map("last_weekly")
  lastWork    DateTime? @map("last_work")
  joinedAt    DateTime  @default(now()) @map("joined_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model minesSession {
  userId        String   @id @map("user_id") @db.VarChar(32)
  channelId     String   @map("channel_id") @db.VarChar(32)
  messageId     String   @map("message_id") @db.VarChar(32)
  bet           BigInt   @map("bet")
  minesCount    Int      @map("mines_count")
  minePositions String   @map("mine_positions") @db.VarChar(64)
  revealedTiles String   @map("revealed_tiles") @db.VarChar(64)
  currentStep   Int      @default(0) @map("current_step")
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("mines_sessions")
}

model blackjackSession {
  userId      String   @id @map("user_id") @db.VarChar(32)
  bet         BigInt   @map("bet")
  deckState   String   @map("deck_state") @db.Text
  playerHand  String   @map("player_hand") @db.Text
  dealerHand  String   @map("dealer_hand") @db.Text
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("blackjack_sessions")
}

model lotteryTicket {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(32)
  guildId    String   @map("guild_id") @db.VarChar(32)
  channelId  String   @map("channel_id") @db.VarChar(32)
  amount     BigInt   @default(0)
  drawDate   DateTime @map("draw_date") @db.Date
  valid      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([drawDate, valid])
  @@map("lottery_tickets")
}

model channelDrop {
  channelId String   @id @map("channel_id") @db.VarChar(32)
  guildId   String   @map("guild_id") @db.VarChar(32)
  amount    BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("channel_drops")
}

model guildConfig {
  guildId             String   @id @map("guild_id") @db.VarChar(32)
  verifyChannelId     String?  @map("verify_channel_id") @db.VarChar(32)
  verifyEmoji         String?  @default("✅") @map("verify_emoji") @db.VarChar(128)
  verifyMessageId     String?  @map("verify_message_id") @db.VarChar(32)
  unverifiedRoleId    String?  @map("unverified_role_id") @db.VarChar(32)
  verifiedRoleId      String?  @map("verified_role_id") @db.VarChar(32)
  welcomeChannelId    String?  @map("welcome_channel_id") @db.VarChar(32)
  goodbyeChannelId    String?  @map("goodbye_channel_id") @db.VarChar(32)
  ticketLogChannelId  String?  @map("ticket_log_channel_id") @db.VarChar(32)
  streakResetHour     Int      @default(0) @map("streak_reset_hour")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("guild_config")
}

model auditLog {
  id              Int      @id @default(autoincrement())
  actorDiscordId  String   @map("actor_discord_id") @db.VarChar(32)
  action          String   @db.VarChar(64)
  detail          String?  @db.Text
  source          String   @default("discord_bot") @db.VarChar(32)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}
