# ============================================
# Cozy Bot — Environment Variables Template
# ============================================
# Copy file ini menjadi .env dan isi nilainya.
# JANGAN PERNAH commit .env ke Git!
# ============================================

# === DISCORD BOT ===
DISCORD_TOKEN=            # Bot token dari Discord Developer Portal
DISCORD_CLIENT_ID=        # Application ID / Client ID
DISCORD_CLIENT_SECRET=    # OAuth2 Client Secret (untuk dashboard)

# === SERVER ===
GUILD_ID=                 # ID server Discord (Cozy For Us)

# === ROLES ===
OWNER_ROLE_ID=            # ID role Owner di server
VERIFIED_ROLE_ID=         # ID role @Verified
UNVERIFIED_ROLE_ID=       # ID role @Unverified

# === DATABASE (MySQL — Pterodactyl Panel) ===
DATABASE_URL=             # mysql://user:pass@host:3306/dbname

# === HOSTING (Pterodactyl) ===
SERVER_PORT=30252         # Port dari Pterodactyl panel
SERVER_IP=0.0.0.0         # Bind address

# === OPTIONAL ===
NODE_ENV=development      # development | production
LOG_LEVEL=info            # debug | info | warn | error
DASHBOARD_URL=            # URL dashboard untuk CORS & OAuth redirect
JWT_SECRET=               # Secret untuk sign JWT session dashboard
