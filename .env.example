# ============================================
# Cozy Bot — Environment Variables Template
# ============================================
# Copy file ini menjadi .env dan isi nilainya.
# JANGAN PERNAH commit .env ke Git!
# ============================================

# === DISCORD BOT ===
DISCORD_TOKEN=            # Bot token dari Discord Developer Portal
DISCORD_CLIENT_ID=        # Application ID / Client ID

# === SERVER ===
GUILD_ID=                 # ID server Discord (Cozy For Us)

# === ROLES & ACCESS ===
OWNER_ID=                 # Discord User ID Owner/Developer (opsional)
OWNER_ROLE_ID=            # ID role Owner di server (opsional)

# === DATABASE (MySQL) ===
DATABASE_URL=             # mysql://user:pass@host:3306/dbname

# === OPTIONAL ===
NODE_ENV=development      # development | production
LOG_LEVEL=info            # debug | info | warn | error
